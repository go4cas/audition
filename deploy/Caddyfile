# Audition's Caddy site file (docs/RELEASE.md). deploy/install.sh renders it
# (domain, port and TLS lines filled in) into the folder your main Caddyfile already
# imports, so no shared Caddy setting changes. There is no global options
# block here on purpose: it would change every site on the server.
#
# TLS: with no certificate files given, Caddy gets a certificate for the domain itself. With
# --tls-cert/--tls-key (for example a Cloudflare origin certificate), it uses
# those files instead.
__DOMAIN__ {
	__TLS__
	encode gzip zstd

	# Requests that come through Cloudflare carry the visitor's address in
	# CF-Connecting-IP. Only trust it from Cloudflare's own addresses
	# (https://www.cloudflare.com/ips/), so nobody can fake it by connecting
	# to the server directly.
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	# The Vaultbase admin (/_/) is not public: reach it through an SSH tunnel.
	# /_/ready stays open for health checks.
	@admin {
		path /_/*
		not path /_/ready
	}

	# The app is Vaultbase's public folder, at the site root (TECH-SPEC Q2).
	# Its CSP travels in index.html; the headers a <meta> tag can't set are
	# added here, only where Vaultbase didn't send its own
	# (vb_hooks/lib/static.ts EDGE_HEADERS).
	@app not path /api/* /_/* /auth/* /realtime
	header @app {
		?Content-Security-Policy "frame-ancestors 'none'"
		?X-Frame-Options DENY
		?Referrer-Policy same-origin
	}

	route {
		respond @admin 404
		reverse_proxy @cloudflare 127.0.0.1:__PORT__ {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
		# Everyone else: Caddy sends the connecting address itself.
		reverse_proxy 127.0.0.1:__PORT__
	}

	log {
		output file /var/log/caddy/audition-access.log
	}
}
