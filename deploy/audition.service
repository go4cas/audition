# Audition on Vaultbase, as a systemd service (docs/RELEASE.md).
# Based on Vaultbase 0.40.2's deploy/systemd/vaultbase.service, with
# Audition's paths: the app checkout is read-only, only the data folder is
# writable.
#
#   sudo cp deploy/audition.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now audition

[Unit]
Description=Audition (Vaultbase)
Documentation=https://github.com/go4cas/audition/blob/main/docs/RELEASE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=audition
Group=audition
EnvironmentFile=/etc/audition/audition.env
# Applies the schema from the checked-out release on every start, exactly as
# `bun run dev` does. /usr/local/bin/vaultbase is a symlink to the pinned,
# checksum-verified binary (see "Install" in RELEASE.md).
ExecStart=/usr/local/bin/vaultbase --apply-snapshot /opt/audition/schema/snapshot.json --snapshot-mode sync
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# No SystemCallFilter: Bun needs syscalls outside @system-service (Vaultbase's
# own unit says the same).

# Only the data folder (database, uploads, keys, backups) is writable.
# /opt/audition (hooks, UI, schema) is read-only to the service, so hook files
# can't be changed from the Vaultbase admin in production: they come from git.
ReadWritePaths=/var/lib/audition
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
