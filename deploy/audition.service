# Audition on Vaultbase, as a systemd service (docs/RELEASE.md).
# Based on Vaultbase 0.40.2's deploy/systemd/vaultbase.service, with
# Audition's paths: the release in /opt/audition is read-only, only the data
# folder is writable. deploy/install.sh installs it; nothing outside
# /opt/audition, /var/lib/audition and /etc/audition is used.

[Unit]
Description=Audition (Vaultbase)
Documentation=https://github.com/go4cas/audition/blob/main/docs/RELEASE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=audition
Group=audition
EnvironmentFile=/etc/audition/audition.env
# The app: the release's built UI is Vaultbase's public folder, served at the
# site root, with page navigations to app routes (/runs/123) answered by its
# index.html (Vaultbase 0.48+, TECH-SPEC Q2). Set here rather than in
# audition.env so every upgrade and rollback brings the right value along.
Environment=VAULTBASE_PUBLIC_DIR=/opt/audition/current/ui/dist
Environment=VAULTBASE_PUBLIC_SPA=1
# Applies the schema from the current release on every start, exactly as
# `bun run dev` does. /opt/audition/bin/vaultbase is a symlink to the pinned,
# checksum-verified binary, and /opt/audition/current to the release in use.
ExecStart=/opt/audition/bin/vaultbase --apply-snapshot /opt/audition/current/schema/snapshot.json --snapshot-mode sync
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
LimitNOFILE=65536
UMask=0077

# Good neighbour on a shared server: caps so a runaway run can't starve the
# other apps. Raise them in a drop-in (systemctl edit audition) if needed.
MemoryHigh=768M
MemoryMax=1G
CPUQuota=150%
TasksMax=512

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# No SystemCallFilter: Bun needs syscalls outside @system-service (Vaultbase's
# own unit says the same).

# Only the data folder (database, uploads, keys, backups) is writable.
# /opt/audition (hooks, UI, schema) is read-only to the service, so hook files
# can't be changed from the Vaultbase admin in production: they come from git.
ReadWritePaths=/var/lib/audition
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
