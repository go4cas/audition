# /etc/audition/audition.env (owner root, group audition, mode 0640).
# deploy/install.sh writes it from this template (filling in the port it
# picked). Read by the systemd unit, and by Vaultbase's own commands when run
# with VAULTBASE_ENV_FILE=/etc/audition/audition.env (docs/RELEASE.md).
# Never put a provider API key here: keys are entered in the app only.
VAULTBASE_DATA_DIR=/var/lib/audition
VAULTBASE_HOOKS_DIR=/opt/audition/current/vb_hooks
AUDITION_UI_DIST=/opt/audition/current/ui/dist
VAULTBASE_HOST=127.0.0.1
VAULTBASE_PORT=__PORT__
# The reverse proxy on the same machine passes the visitor's address in
# X-Forwarded-For (from Cloudflare's CF-Connecting-IP when the request came
# through Cloudflare); trust it only from loopback.
VAULTBASE_TRUSTED_PROXIES=127.0.0.1,::1
# Turns on Vaultbase's production guard for `vaultbase wipe`.
NODE_ENV=production
